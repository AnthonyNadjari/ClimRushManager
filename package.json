{
  "name": "climrush-manager-root",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "db:prepare": "npm run db:prepare --prefix web",
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "build:check": "npm run build:check --prefix web",
    "start": "npm run start --prefix web",
    "setup:local": "npm run docker:up && npm run db:prepare"
  }
}

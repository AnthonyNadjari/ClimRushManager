# PostgreSQL (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# DIRECT_URL : connexion DIRECTE utilisée par les migrations Prisma (build / db:prepare).
# - Pooler « session » (port 5432) : la même URL que DATABASE_URL convient.
# - Pooler « transaction » (port 6543, recommandé pour le runtime serverless Vercel) :
#   mettez ici la connexion directe (port 5432) car les migrations ne passent pas par le pooler transaction.
# Si elle est omise sur Vercel, le build retombe automatiquement sur DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Supabase (recommandé : pooler « session », port 5432 — voir Settings → Database)
# postgresql://postgres.VOTRE_REF:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Optionnel : instance OSRM privée (sinon router.project-osrm.org)
# OSRM_BASE_URL="https://votre-osrm.example.com"

# Optionnel : URL publique du site
NEXT_PUBLIC_APP_URL=

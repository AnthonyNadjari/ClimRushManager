# Copier vers web/.env pour utiliser le PostgreSQL de docker-compose (racine du dépôt).
DATABASE_URL="postgresql://climrush:climrush@127.0.0.1:5432/climrush"
# DIRECT_URL est requis par le schéma Prisma (migrations). En local, identique à DATABASE_URL.
DIRECT_URL="postgresql://climrush:climrush@127.0.0.1:5432/climrush"

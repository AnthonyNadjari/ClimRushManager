generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MachineStatus {
  DISPO
  LOUE
  RESA
  LIV
  SAV
}

enum ClientStatus {
  en_cours
  a_venir
  inactif
}

enum FieldMode {
  livraison
  reprise
}

enum FieldTaskStatus {
  pending
  in_progress
  done
}

enum MaintPriority {
  urgent
  nettoyage
  mineur
  done
}

model Machine {
  id                    String        @id
  model                 String
  lot                   String
  status                MachineStatus
  clientId              String?
  client                Client?       @relation(fields: [clientId], references: [id])
  clientName            String?
  returnDate            String?
  purchasePriceHt       Float
  cumulativeRevenueHt   Float
  contract              String
  daysRented            Int
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Client {
  id               String       @id
  name             String
  initials         String
  status           ClientStatus
  daysRented       Int
  caHt             Float
  email            String
  phone            String
  address          String       @default("")
  alert            String?
  lotSummary       String?
  assignedMachines Machine[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model FieldTask {
  id             String          @id
  mode           FieldMode
  clientLabel    String
  address        String
  phone          String
  qty            Int
  status         FieldTaskStatus
  timeNote       String?
  upsell         String?
  extraNote      String?
  truckLabel     String          @default("Tous")
  machineIdsJson String          @default("[]")
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model MaintenanceTicket {
  id        String        @id
  machineId String
  title     String
  detail    String
  priority  MaintPriority
  action    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Reservation {
  id        String    @id @default(cuid())
  date      DateTime
  endDate   DateTime?
  client    String
  machines  Int
  type      String
  priceHt   Float?
  model     String?
  createdAt DateTime  @default(now())
}

model Activity {
  id        String   @id
  kind      String
  title     String
  subtitle  String
  time      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

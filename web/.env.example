# PostgreSQL (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Supabase (recommandé : pooler « session », port 5432 — voir Settings → Database)
# postgresql://postgres.VOTRE_REF:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Optionnel : instance OSRM privée (sinon router.project-osrm.org)
# OSRM_BASE_URL="https://votre-osrm.example.com"

# Optionnel : URL publique du site
NEXT_PUBLIC_APP_URL=
